{
  "include": "~/.config/waybar/modules",
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 12,
  "fixed-center": true,
  "ipc": true,
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": ["clock#gar", "backlight#gar", "battery#gar", "custom/updater", "tray"],

  "modules-center": ["hyprland/workspaces#gar"],

  "modules-right": ["pulseaudio#gar"],


  // =========================================================================
  // M O D U L E S
  // =========================================================================

  "hyprland/workspaces#gar": {
    "disable-scroll": true,
    "all-outputs": false,
    "active-only": false,
    "format": "{icon}",
    "persistent_workspaces": {
      "*": 5
    },
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    }
  },

  "clock#gar": {
    "format": "{:%a %d | %H:%M}",
    "format-alt": "{:%A, %d %B, %Y (%R)}"
  },

  "hyprland/window#gar": {
    "format": "{}",
    "max-length": 60
  },

  "tray#gar": {
    "icon-size": 15,
    "spacing": 10
  },

  "pulseaudio#gar": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-bluetooth-muted": " {icon}",
    "format-muted": "󰸈",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pamixer --toggle-mute",
    "on-click-right": "pavucontrol",
    "tooltip": false
  },

  "backlight#gar": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["", ""]
  },

  "battery#gar": {
    "interval": 60,
    "align": 0,
    "rotate": 0,
    "full-at": 100,
    "design-capacity": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "󱘖 {capacity}%",
    "format-full": "{icon} Full",
    "format-alt": "{icon} {time}",
    "format-icons": ["", "", "", "", ""],
    "format-time": "{H}h {M}min",
    "tooltip": true,
    "tooltip-format": "{timeTo} {power}w",
    "on-click-middle": "~/.config/hypr/scripts/ChangeBlur.sh",
    "on-click-right": "~/.config/hypr/scripts/Wlogout.sh"
  },

  "custom/updater": {
    "format": " {}",
    "exec": "checkupdates | wc -l",
    "exec-if": "[[ $(checkupdates | wc -l) -gt 0 ]]",
    "interval": 15,
    "on-click": "kitty -T update bash -c 'yay -Syu; echo \"Press Enter to exit...\"; read line'"
  }
}
