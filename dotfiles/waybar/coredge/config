{
  "include": [
    "$HOME/.config/waybar/module/workspace_module",
    "$HOME/.config/waybar/module/notification_module",
    "$HOME/.config/waybar/module/monitor_module",
    "$HOME/.config/waybar/module/agenda_module"
  ],
  "layer": "top",
  "position": "top",
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 2,
  "tooltip": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/logo",
    "group/hworkspaces"
  ],
  "modules-right": [
    "custom/recorder",
    "group/monitor",
    "group/settings",
    "tray",
    "custom/agenda",
    "clock",
    "custom/notification"
  ],
  "clock": {
    "format": " {:%H:%M, %d %B %Y} ",
    "format-alt": " {:%A, %H:%M:%S} ",
    "interval": 1,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "group/monitor": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 1000,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "custom/monitor",
      "cpu",
      "memory",
      "temperature"
    ]
  },
  "group/settings": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 1000,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "custom/settings",
      "battery",
      "power-profiles-daemon",
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "charging": [
        "󰢟",
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "plugged": [
        ""
      ]
    },
    "tooltip-format": "Battery: {capacity}%\nPower: {power}W\n{timeTo}",
    "tooltip": true
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 ",
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "",
        "",
        ""
      ]
    },
    "sink-mapping": {
      "easyeffects_sink": "alsa_output.usb-SteelSeries_SteelSeries_Arctis_Nova_5-00.pro-output-0"
    },
    "on-click": "pactl set-sink-mute alsa_output.usb-SteelSeries_SteelSeries_Arctis_Nova_5-00.pro-output-0 toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Volume: {volume}%"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "sink-mapping": {
      "easyeffects_sink": "alsa_output.usb-SteelSeries_SteelSeries_Arctis_Nova_5-00.pro-output-0"
    }
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "show-passive-items": true
  },
"custom/recorder": {
    "exec": "if [ -f /tmp/recording_time ]; then cat /tmp/recording_time; fi",
    "exec-if": "[ -f /tmp/recording_pid ]",
    "interval": 1,
    "format": " {text}",
    "return-type": "plain",
    "hide-empty": true,
    "on-click": "$HOME/.local/bin/record.sh",
    "tooltip": true,
    "tooltip-format": "Stop recording"
  },
  "custom/logo": {
    "format": "󰮯",
    "tooltip-format": "Have a nice day!",
    "tooltip": true,
    "on-click": "$HOME/.local/bin/inir overview open"
  },
  "custom/monitor": {
    "format": "",
    "tooltip-format": "Click to show monitor stats",
    "tooltip": true
  },
  "custom/settings": {
    "format": "",
    "tooltip-format": "Click to show settings",
    "tooltip": true
  },
  "modules-center": []
}
