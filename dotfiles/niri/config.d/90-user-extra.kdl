// ─────────────────────────────────────────────────────────────────────────────
// 90 — Your personal overrides
// ─────────────────────────────────────────────────────────────────────────────
//
// This file is YOURS. iNiR updates will never overwrite it.
// Put any custom configuration here: extra binds, per-app window rules,
// named workspaces, etc.
//
// Monitor-specific workspace pinning (which monitor each workspace opens on)
// lives in monitor.lotus.kdl, NOT here, so this file stays portable across
// machines. See the comment at the top of monitor.kdl / monitor.lotus.kdl.
//
// Since Niri evaluates config top-to-bottom, settings here take effect
// after all other config.d files. For window-rule properties, all matching
// rules accumulate. For scalar values (like gaps), the last one wins.
// ─────────────────────────────────────────────────────────────────────────────

// Enable VRR (G-Sync) when a game is focused — needs on-demand=true for the
// relevant output in monitor.kdl (monitor.lotus.kdl sets it for DP-2).
window-rule {
    match app-id=r#"^steam_app_\d+$"#
    match app-id=r#"^gamescope$"#
    match app-id=r#"^steam_proton$"#
    match app-id=r#"^heroic$"#
    match app-id=r#"^lutris$"#
    variable-refresh-rate true
}

// Keybindings to navigate and move windows to the new workspaces
binds {
    // Focus specific workspaces
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }

    // Move focused column to specific workspaces
    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }
}
