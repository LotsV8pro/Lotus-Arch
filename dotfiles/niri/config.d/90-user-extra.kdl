// ─────────────────────────────────────────────────────────────────────────────
// 90 — Your personal overrides
// ─────────────────────────────────────────────────────────────────────────────
//
// This file is YOURS. iNiR updates will never overwrite it.
// Put any custom configuration here: extra binds, per-app window rules,
// output configuration, named workspaces, etc.
//
// Since Niri evaluates config top-to-bottom, settings here take effect
// after all other config.d files. For window-rule properties, all matching
// rules accumulate. For scalar values (like gaps), the last one wins.
// ─────────────────────────────────────────────────────────────────────────────

// Static workspaces assigned to specific monitors (DP-2 is main)
workspace "1" { open-on-output "DP-2"; }
workspace "2" { open-on-output "DP-2"; }
workspace "3" { open-on-output "DP-2"; }

// Change "HDMI-A-1" to your actual secondary monitor name if needed
workspace "4" { open-on-output "HDMI-A-1"; }
workspace "5" { open-on-output "HDMI-A-1"; }

// Automatically open specific communication and media apps on the 2nd monitor
window-rule {
    // Discord (matches native package, flatpak, and web wrapper app-ids)
    match app-id="discord"
    match app-id="com.discordapp.Discord"
    open-on-workspace "4"
}

window-rule {
    // Spotify (Added "Spotify" with capital S to fix the rule)
    match app-id="Spotify"
    match app-id="spotify"
    match app-id="com.spotify.Client"
    open-on-workspace "5"
}
// Enable VRR (G-Sync) when a game is focused — needs on-demand=true in monitor.kdl
window-rule {
    match app-id=r#"^steam_app_\d+$"#
    match app-id=r#"^gamescope$"#
    match app-id=r#"^steam_proton$"#
    match app-id=r#"^heroic$"#
    match app-id=r#"^lutris$"#
    variable-refresh-rate true
}

// Ready or Not (Proton/XWayland) — ensure VRR engages (app-id and title fallback)
window-rule {
    match app-id=r#"^steam_app_1144200$"#
    match title=r#"^Ready or Not$"#
    variable-refresh-rate true
}

// Keybindings to navigate and move windows to the new workspaces
binds {
    // Focus specific workspaces
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }

    // Move focused column to specific workspaces
    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }

    // ─────────────────────────────────────────────────────────────────────────
    // Hotkeys for the shell features that had none.
    //
    // These panels were only reachable by clicking: the media panel that
    // slides up from the bottom of the screen, the quick-settings panel,
    // the task view, the window switcher, the equalizer and the screen
    // zoom. Every combo below was checked against every combo already in
    // use (Mod+*, Super+*, Mod+Shift+*, Mod+Ctrl+*, Mod+Alt+*) so nothing
    // is shadowed.
    //
    // "Super" is used literally (not "Mod") so these keep working the same
    // way inside a nested Niri window, where Mod turns into Alt.
    // ─────────────────────────────────────────────────────────────────────────

    // Media panel — the one that slides up from the bottom of the screen.
    Super+M { spawn "inir" "mediaControls" "toggle"; }

    // Quick settings / control panel.
    Super+Shift+C { spawn "inir" "controlPanel" "toggle"; }

    // Task view — all windows at once.
    Super+Shift+T { spawn "inir" "taskview" "toggle"; }

    // Window switcher.
    Super+Shift+Tab { spawn "inir" "altSwitcher" "open"; }

    // Cycle between the panel styles (ii / waffle).
    Super+Shift+F { spawn "inir" "panelFamily" "cycle"; }

    // YouTube Music play/pause.
    Super+Y { spawn "inir" "ytmusic" "playPause"; }

    // Screen zoom.
    Super+Ctrl+Equal { spawn "inir" "zoom" "zoomIn"; }
    Super+Ctrl+Minus { spawn "inir" "zoom" "zoomOut"; }

    // Workspace orbit navigator.
    Super+O { spawn "inir" "orbit" "toggle"; }

    // Welcome / activity dashboard.
    Super+I { spawn "inir" "dashboard" "open"; }

    // Play/pause the active media player.
    Super+U { spawn "inir" "mpris" "playPause"; }

    // Performance mode for games (disables animations).
    Super+X { spawn "inir" "gamemode" "toggle"; }

    // Send the focused window to the workspace the other monitor has
    // active right now (does not create new workspaces).
    Mod+Shift+BracketLeft  { move-window-to-monitor-left; }
    Mod+Shift+BracketRight { move-window-to-monitor-right; }
}

// Monitor principal Gaming (DP-2) a 165Hz (164.998), a la izquierda
output "DP-2" {
    mode "2560x1440@164.998"
    variable-refresh-rate
    scale 1.0
    position x=0 y=0
}

// Monitor secundario Samsung (HDMI-A-1) a la derecha del DP-2
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1.0
    position x=2560 y=0
}

// Waybar is disabled since 2026-11-08: iNiR 3.0.0 draws the bar from the
// ii Quickshell family (quickshell:bar) and the two overlapped.
// To go back: uncomment this and close the iNiR bar with `inir bar close`.
// spawn-at-startup "sh" "-c" "$HOME/.local/bin/waybar_manager.sh"
