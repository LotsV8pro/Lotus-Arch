// ─────────────────────────────────────────────────────────────────────────────
// 60 — Animations
// ─────────────────────────────────────────────────────────────────────────────
// Docs: https://niri-wm.github.io/niri/Configuration:-Animations
//
// Movement animations use spring physics with three parameters:
//
//   damping-ratio  How quickly the spring settles.
//                  < 1.0 = bouncy / oscillates
//                  = 1.0 = critically damped (settles fastest, no overshoot)
//                  > 1.0 = overdamped (slow, sluggish stop)
//
//   stiffness      How "snappy" the spring is. Higher = faster movement.
//
//   epsilon        Threshold to consider the animation "done" (0.0001 is fine).
//
// You can also use duration-based easing instead of springs:
//   duration-ms 250 curve "ease-out-expo"
// ─────────────────────────────────────────────────────────────────────────────

animations {
    // Uncomment to disable all animations globally.
    // off

    // Slow down every animation by this factor (useful for debugging).
    // Values below 1.0 speed them up. Default: 1.0
    // slowdown 3.0

    // ── Workspace transitions ───────────────────────────────────────────────
    workspace-switch {
        spring damping-ratio=0.98 stiffness=700 epsilon=0.0001
    }

    // ── Window lifecycle ────────────────────────────────────────────────────
    // Iris (circular) opening from the top-left corner
    window-open {
        duration-ms 200
        curve "ease-out-quad"
        custom-shader r"
            vec4 open_circular_iris_tl(vec3 coords_geo, vec3 size_geo) {
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec2 uv = coords_tex.st;

                float p = niri_clamped_progress;

                vec2 center = vec2(0.0, 0.0);

                vec2 aspect_uv = uv - center;
                aspect_uv.x *= size_geo.x / max(size_geo.y, 1.0);

                float dist = length(aspect_uv);

                float max_radius = length(vec2(1.0 * (size_geo.x / max(size_geo.y, 1.0)), 1.0));
                float current_radius = max_radius * p;

                float feather = 0.03;

                if (dist > current_radius) {
                    return vec4(0.0);
                }

                vec4 color = texture2D(niri_tex, uv);

                float alpha = smoothstep(current_radius, current_radius - feather, dist);
                color *= alpha;

                color *= smoothstep(0.0, 0.2, p);

                return color;
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                return open_circular_iris_tl(coords_geo, size_geo);
            }
        "
    }

    // Iris (circular) closing into the top-left corner
    window-close {
        duration-ms 200
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_circular_iris_tl(vec3 coords_geo, vec3 size_geo) {
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec2 uv = coords_tex.st;

                float p = niri_clamped_progress;

                vec2 center = vec2(0.0, 0.0);

                vec2 aspect_uv = uv - center;
                aspect_uv.x *= size_geo.x / max(size_geo.y, 1.0);

                float dist = length(aspect_uv);

                float max_radius = length(vec2(1.0 * (size_geo.x / max(size_geo.y, 1.0)), 1.0));
                float current_radius = max_radius * (1.0 - p);

                float feather = 0.03;

                if (dist > current_radius) {
                    return vec4(0.0);
                }

                vec4 color = texture2D(niri_tex, uv);

                float alpha = smoothstep(current_radius, current_radius - feather, dist);
                color *= alpha;

                color *= smoothstep(1.0, 0.8, p);

                return color;
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                return close_circular_iris_tl(coords_geo, size_geo);
            }
        "
    }

    // ── Layout movement ─────────────────────────────────────────────────────
    // Scrolling the horizontal strip when you focus a different column.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    // Dragging or moving a window between columns/workspaces.
    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    // Interactive column/window resize.
    window-resize {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    // ── UI chrome ───────────────────────────────────────────────────────────
    // The "config saved" toast that appears after editing this file.
    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=750 epsilon=0.001
    }

    // Niri's built-in screenshot UI opening.
    screenshot-ui-open {
        duration-ms 210
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    recent-windows-close {
        duration-ms 160
        curve "ease-out-quad"
    }
}
