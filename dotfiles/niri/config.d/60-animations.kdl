// ─────────────────────────────────────────────────────────────────────────────
// 60 — Animations
// ─────────────────────────────────────────────────────────────────────────────
// Docs: https://niri-wm.github.io/niri/Configuration:-Animations
//
// Movement animations use spring physics with three parameters:
//
//   damping-ratio  How quickly the spring settles.
//                  < 1.0 = bouncy / oscillates
//                  = 1.0 = critically damped (settles fastest, no overshoot)
//                  > 1.0 = overdamped (slow, sluggish stop)
//
//   stiffness      How "snappy" the spring is. Higher = faster movement.
//
//   epsilon        Threshold to consider the animation "done" (0.0001 is fine).
//
// You can also use duration-based easing instead of springs:
//   duration-ms 250 curve "ease-out-expo"
// ─────────────────────────────────────────────────────────────────────────────

animations {
    // Uncomment to disable all animations globally.
    //off

    // Slow down every animation by this factor (useful for debugging).
    // Values below 1.0 speed them up. Default: 1.0
    // slowdown 3.0

    // ── Workspace transitions ───────────────────────────────────────────────
    workspace-switch {
        spring damping-ratio=0.98 stiffness=700 epsilon=0.0001
    }

    // ── Window lifecycle ────────────────────────────────────────────────────
    // Iris (circular) opening from the top-left corner
    window-open {
        duration-ms 200
        curve "ease-out-quad"
        // Iris from the top-left corner (optimized: see the note below).
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                vec2 uv = (niri_geo_to_tex * coords_geo).st;
                float p = niri_clamped_progress;
                float ar = size_geo.x / size_geo.y;
                vec2 d = vec2(uv.x * ar, uv.y);
                float dist = sqrt(dot(d, d));
                float m = length(vec2(ar, 1.0)) * p;
                float a = clamp((m - dist) / 0.03, 0.0, 1.0);
                if (a <= 0.0) { return vec4(0.0); }
                return texture2D(niri_tex, uv) * a * smoothstep(0.0, 0.2, p);
            }
        "
    }

    // Iris (circular) closing into the top-left corner
    window-close {
        duration-ms 200
        curve "ease-out-quad"
        // Iris closing back into the top-left corner.
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                vec2 uv = (niri_geo_to_tex * coords_geo).st;
                float p = niri_clamped_progress;
                float ar = size_geo.x / size_geo.y;
                vec2 d = vec2(uv.x * ar, uv.y);
                float dist = sqrt(dot(d, d));
                float m = length(vec2(ar, 1.0)) * (1.0 - p);
                float a = clamp((m - dist) / 0.03, 0.0, 1.0);
                if (a <= 0.0) { return vec4(0.0); }
                return texture2D(niri_tex, uv) * a * smoothstep(1.0, 0.8, p);
            }
        "
    }

    // ── Layer surfaces (Quickshell bars, panels, sidebars, notifications) ───
    // Same iris effect as windows, so layer-shell surfaces animate too.
    layer-open {
        duration-ms 200
        curve "ease-out-quad"
        // Same iris for panels, sidebars, notifications and the overview.
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                vec2 uv = (niri_geo_to_tex * coords_geo).st;
                float p = niri_clamped_progress;
                float ar = size_geo.x / size_geo.y;
                vec2 d = vec2(uv.x * ar, uv.y);
                float dist = sqrt(dot(d, d));
                float m = length(vec2(ar, 1.0)) * p;
                float a = clamp((m - dist) / 0.03, 0.0, 1.0);
                if (a <= 0.0) { return vec4(0.0); }
                return texture2D(niri_tex, uv) * a * smoothstep(0.0, 0.2, p);
            }
        "
    }

    layer-close {
        duration-ms 200
        curve "ease-out-quad"
        // Same close animation for panels, sidebars, notifications and overview.
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                vec2 uv = (niri_geo_to_tex * coords_geo).st;
                float p = niri_clamped_progress;
                float ar = size_geo.x / size_geo.y;
                vec2 d = vec2(uv.x * ar, uv.y);
                float dist = sqrt(dot(d, d));
                float m = length(vec2(ar, 1.0)) * (1.0 - p);
                float a = clamp((m - dist) / 0.03, 0.0, 1.0);
                if (a <= 0.0) { return vec4(0.0); }
                return texture2D(niri_tex, uv) * a * smoothstep(1.0, 0.8, p);
            }
        "
    }

    // ── Layout movement ─────────────────────────────────────────────────────
    // Scrolling the horizontal strip when you focus a different column.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    // Dragging or moving a window between columns/workspaces.
    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    // Interactive column/window resize.
    window-resize {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    // ── UI chrome ───────────────────────────────────────────────────────────
    // The "config saved" toast that appears after editing this file.
    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=750 epsilon=0.001
    }

    // Niri's built-in screenshot UI opening.
    screenshot-ui-open {
        duration-ms 210
        curve "ease-out-quad"
    }

    overview-open-close {
        // It rejects custom-shader (checked with niri validate), so the timing
        // is matched to the iris to keep the transition visually consistent.
        duration-ms 200
        curve "ease-out-quad"
    }

    recent-windows-close {
        duration-ms 200
        curve "ease-out-quad"
    }
}
