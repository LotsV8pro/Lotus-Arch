// Output layout of the Lotus reference build, applied by the installer only
// when both connectors are physically connected (06-dotfiles.sh reads
// /sys/class/drm). Other machines keep an empty monitor.kdl and let niri pick
// the preferred mode.
//
//   DP-2      2560x1440 @ 165 Hz, left, variable refresh rate
//   HDMI-A-1  1920x1080 @ 60 Hz, right
//
// Nothing here ties workspaces or apps to a monitor; that is per-app state in
// niri-window-memory and plain Mod+1..5 binds.
output "DP-2" {
    mode "2560x1440@164.998"
    scale 1.0
    position x=0 y=0
    variable-refresh-rate
}

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1.0
    position x=2560 y=0
}
