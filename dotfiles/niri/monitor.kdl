// Machine-specific output config, included from config.kdl.
// On the reference build the installer overwrites this with monitor.lotus.kdl;
// on any other machine it is left empty so niri picks the preferred mode and
// arranges whatever outputs are connected. nwg-displays writes this file when
// you change the layout from the GUI.
output "DP-2" {
    mode "2560x1440@164.998"
    scale 1.0
    position x=0 y=0
    variable-refresh-rate
}

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1.0
    position x=2560 y=0
}
