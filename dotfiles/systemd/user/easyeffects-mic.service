[Unit]
Description=Easy Effects (cadena de microfono "Radio Mic")
Documentation=man:systemd-xdg-autostart-generator(8)
After=graphical-session.target
PartOf=graphical-session.target
Wants=pipewire.service
After=pipewire.service pipewire-pulse.service

[Service]
Type=exec
# No pkill here on purpose: if you have the Easy Effects window open, the new
# instance finds the DBus name taken, exits with 0 and the unit stays inactive.
# Killing it would throw away any preset you were editing. mic-ee-guard starts
# the service again when the chain is missing and nothing else is running.
ExecStart=/usr/bin/easyeffects --hide-window --service-mode
Restart=on-failure
RestartSec=5

# IMPORTANT: do NOT use the Easy Effects CLI here (easyeffects --bypass 2).
# The CLI starts a SECOND full instance that competes for the virtual source
# "easyeffects_source" and leaves this instance without a plugin chain (the
# mic goes through raw and sounds very low). Talk to the running instance
# over its local socket (/run/user/%U/EasyEffectsServer) instead.
#
#   global_bypass:0         -> turn the global bypass off (mic gets processed)
#   microphone_monitoring:1 -> keep the input chain connected
#
# With the bypass on, Easy Effects unloads the input chain plugins and the
# mic goes through raw and very low.
#
# Microphone monitoring comes from listenToMicVolume=0.0 in the config file:
# it keeps the chain alive while sending nothing to the speakers (no
# acoustic feedback).
ExecStartPost=/bin/sh -c 'sleep 4; printf "global_bypass:0\n" | socat - UNIX-CONNECT:/run/user/%U/EasyEffectsServer 2>/dev/null || true; printf "microphone_monitoring:1\n" | socat - UNIX-CONNECT:/run/user/%U/EasyEffectsServer 2>/dev/null || true'
TimeoutStopSec=5s
Slice=app.slice
ExecCondition=/usr/lib/systemd/systemd-xdg-autostart-condition "" "GNOME"

[Install]
WantedBy=default.target
