[Unit]
Description=Micro interno para 'Radio Mic': mantiene la fuente de entrada
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/mic-radio-hardware
# The helper exits 0 when no card has a Rear Mic control, so the unit
# stays inactive instead of restarting every 2 seconds forever.
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
