[Unit]
Description=Auto-link Arctis Game/Media audio to OBS virtual sink
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service
StartLimitInterval=1min
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.config/hypr/auto_link_obs.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
