[Unit]
Description=iNiR shell
# The graphical-session environment (DISPLAY, WAYLAND_DISPLAY) is published
# by the running compositor.  This unit is compositor-agnostic: it is pulled
# in via graphical-session.target.wants under Hyprland, or via
# niri.service.wants under Lotusiri.  Retaining After=niri.service only
# orders iNiR after niri when niri is part of the transaction (harmless
# otherwise); Requisite=niri.service was removed so iNiR also starts on
# Hyprland, where niri.service never runs.
PartOf=niri.service
After=niri.service
# Keep the StatusNotifier watcher ready before desktop autostart applications
# register tray items.  Niri also orders itself before this target.
Before=xdg-desktop-autostart.target
# Rate-limit restarts: max 3 attempts in 30 seconds, then stop trying.
# These MUST live in [Unit], not [Service] — systemd ignores them elsewhere.
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
# qs runs in the foreground from `inir run --session`; the StatusNotifier
# watcher is provided by the inir-xembedsniproxy child (systemd-run), NOT by
# the qs main PID — so Type=dbus would wait 90s for a bus name qs never
# acquires, time out, and kill the whole shell on every start.
Type=simple

# Pre-seed stable environment so the bash wrapper skips detection at boot.
# QT_SCALE_FACTOR must be 1 — shell scaling is handled in QML.
# QT_SCALE_FACTOR_ROUNDING_POLICY=RoundPreferFloor prevents blurry rendering
# when compositor uses fractional scaling (1.25 etc) — Qt rounds to integer.
# QT_LOGGING_RULES suppresses noisy Qt/KF warnings.
Environment=QT_SCALE_FACTOR=1
Environment=QT_SCALE_FACTOR_ROUNDING_POLICY=RoundPreferFloor
Environment=QT_LOGGING_RULES=quickshell.dbus.properties=false;qt.qml.settings.warning=false;qt.core.qsettings.warning=false;kf.xmlgui=false;kf.coreaddons=false;kf.config.core=false;kf.iconthemes=false

ExecStart=%h/.local/bin/inir run --session
SuccessExitStatus=143

# process mode: only SIGTERM the main PID so user-spawned apps (terminals,
# media players, etc.) survive shell restarts.  Orphan shell helpers are
# cleaned by ExecStopPost instead.
KillMode=process
KillSignal=SIGTERM

# on-failure: restart on both signals (SIGSEGV, SIGABRT) AND non-zero exit
# codes (QML errors, unhandled exceptions).  Clean SIGTERM shutdown is already
# excluded via SuccessExitStatus=143.  The rate limiter (3 in 30s) prevents
# infinite crash loops — after 3 rapid failures systemd gives up.
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Disable coredumps and QS crash reports.  Unpatched Quickshell segfaults
# on hot-reload (use-after-free in IpcHandlerRegistry — extensions freed
# before root destruction).  Each coredump is 45-90 MB and QS crash reports
# accumulate in ~/.cache/quickshell/crashes/.  See patches/quickshell/ for
# the upstream fix.
LimitCORE=0
Environment=QS_DISABLE_CRASH_HANDLER=1

# Clean up stale Quickshell runtime entries (by-pid, by-id) left behind
# after crashes.  KillMode=process only kills the main PID, so orphaned
# QS child processes and their runtime artifacts accumulate over time.
ExecStopPost=-%h/.local/bin/inir cleanup-orphans

# Boost I/O priority so QML/Qt library loading wins over background services
# during cold-boot I/O contention (portals, tray apps, etc.)
IOSchedulingPriority=2

# No [Install] section — wiring is managed by 'inir service enable' which
# creates a compositor-specific wants link (e.g. niri.service.wants/) so
# inir only starts under the correct compositor, not under KDE/GNOME/etc.
