{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "raw",
        "source": [
            "        ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄        ",
            "      ▄█████████████████████▄      ",
            "    ▄█████████████████████████▄    ",
            "   █████████████████████████████   ",
            "   ███▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀████   ",
            "   ███ ████▀▀▀▀▀▀▀▀████ ███ ███   ",
            "   ███ ███         ███ ███ ███   ",
            "   ███ ███  ▄▄▄▄▄  ███ ███ ███   ",
            "   ███ ███ █     █ ███ ███ ███   ",
            "   ███ ███  ▀▄▄▄▀  ███ ███ ███   ",
            "   ███ ███         ███ ███ ███   ",
            "   ███ ███▄▄▄▄▄▄▄▄███ ███ ███   ",
            "   ███▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀████   ",
            "   █████████████████████████████   ",
            "    ▀█████████████████████████▀    ",
            "      ▀█████████████████████▀      ",
            "        ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀        "
        ],
        "padding": {
            "top": 0,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " → "
    },
    "modules": [
        { "type": "custom", "format": "  ▌D̷E̷D̷S̷E̷C̷▌ SYSTEM OVERRIDE" },
        { "type": "custom", "format": "  ┊" },
        { "type": "os", "key": "  ┊ OS", "keyColor": "green" },
        { "type": "kernel", "key": "  ┊ KERNEL", "keyColor": "green" },
        { "type": "custom", "format": "  ┊" },
        { "type": "cpu", "key": "  ┊ CPU", "keyColor": "green" },
        { "type": "gpu", "key": "  ┊ GPU", "keyColor": "green" },
        { "type": "custom", "format": "  ┊" },
        { "type": "shell", "key": "  ┊ SHELL", "keyColor": "green" },
        { "type": "terminal", "key": "  ┊ TERMINAL", "keyColor": "green" },
        { "type": "custom", "format": "  ┊" },
        { "type": "uptime", "key": "  ┊ UPTIME", "keyColor": "green" },
        { "type": "loadavg", "key": "  ┊ LOAD", "keyColor": "green" },
        { "type": "custom", "format": "  ┊" },
        { "type": "media", "key": "  ┊ MEDIA", "keyColor": "green" },
        { "type": "custom", "format": "  ┊" },
        { "type": "custom", "format": "  ▌[!] ACCESS GRANTED" }
    ]
}
